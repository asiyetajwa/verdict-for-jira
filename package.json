{
  "name": "verdict-for-jira",
  "version": "0.1.0",
  "description": "A Rovo agent for Jira that triages an issue into Duplicate, Ready to Build, Blocked or Risky, cites real evidence, and signs a receipt.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "eval": "tsx seed/eval.ts",
    "typecheck": "tsc --noEmit",
    "build:ui": "node ui/build.mjs",
    "preview": "node ui/build.mjs --preview",
    "check": "tsc --noEmit && tsx --test test/*.test.ts && node ui/build.mjs",
    "manifest:production": "node scripts/production-manifest.mjs"
  },
  "devDependencies": {
    "@forge/bridge": "^7.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/events": "^3.0.11",
    "@forge/kvs": "^2.1.3",
    "@forge/llm": "^1.1.0",
    "@forge/resolver": "^2.0.2"
  }
}
